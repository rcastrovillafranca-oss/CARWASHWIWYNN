# Copia este archivo como ".env" y llena los valores reales.
# ".env" nunca se sube a git (ver .gitignore) — este ejemplo sí, para que
# cualquiera que clone el repo sepa qué necesita configurar.
#
# Este sitio es 100% estático (sin backend propio), así que en realidad
# solo dos valores llegan al navegador: la URL del proyecto y la
# publishable/anon key. Se pegan directo en config.js (ver README paso 2),
# NO se leen desde este .env en producción.

# --- Van al frontend (config.js) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# o, si tu proyecto usa el formato anterior de keys:
# SUPABASE_ANON_KEY=eyJ...

# --- NUNCA van al frontend, solo para scripts locales/servidor si algún día se necesitan ---
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxx
